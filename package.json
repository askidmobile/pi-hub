{
  "name": "pi-hub-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b packages/* && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b packages/* && tsc -p packages/hub/tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:attribution": "bash scripts/check-attribution.sh",
    "e2e": "node scripts/e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
